{
  "alert_type": "on_change",
  "disabled": false,
  "frequency": 900,
  "name": "Complex Filters",
  "query": {
    "calculations": [
      {
        "op": "COUNT"
      }
    ],
    "filter_combination": "AND",
    "filters": [
      {
        "column": "endpoint",
        "op": "in",
        "value": [
          "/api/v1",
          "/api/v2"
        ]
      },
      {
        "column": "duration_ms",
        "op": ">",
        "value": 1000
      }
    ],
    "time_range": 3600
  },
  "threshold": {
    "op": "<=",
    "value": 10.0
  }
}