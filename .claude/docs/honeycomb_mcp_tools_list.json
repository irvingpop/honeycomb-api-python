      "type": "boolean",
      "description": "Query all datasets in the environment. When true, dataset_slug is not required. Incompatible with legacy environments.",
      "default": false
    },
    "include_samples": {
      "type": "boolean",
      "description": "Include raw event samples (up to 10 events) that match the query filters.",
      "default": false
    },
    "query_spec": {
      "type": "object",
      "description": "Core query parameters for filtering, aggregation, and ordering. RELATIONAL FIELDS: Use prefixes (root., parent., child., any., none.) to query across trace spans. Constraints: 1) Not allowed in calculations, 2) 'any' in GROUP BY requires matching WHERE clause, 3) 'none' not allowed in GROUP BY, 4) OR combination not supported with relational fields",
      "required": [
        "calculations"
      ],
      "properties": {
        "breakdowns": {
          "type": "array",
          "description": "Fields to group results by. Supports relational field prefixes: root., parent., child., any., any2., any3. (e.g., 'root.service.name'). Duplicates not allowed. Note: 'any' requires matching filter, 'none' not allowed in GROUP BY.",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^((root|parent|child|any|any2|any3)\\.|[^.]+)"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "calculated_fields": {
          "type": "array",
          "description": "Derived columns from raw fields only (cannot reference other calculated_fields). IMPORTANT: Expression functions like GTE, LTE, GT, LT, EQUALS are ONLY valid inside calculated_fields expressions, NOT as filter operators. Functions return null on error. REG_* uses RE2. Time functions use UTC.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "expression"
            ],
            "properties": {
              "expression": {
                "type": "string",
                "description": "Expression with $field refs. Comparison: LT, LTE, GT, GTE, EQUALS, IN (these are NOT filter ops). Logic: AND, OR, NOT. Types: INT/FLOAT/STRING/BOOL. Time: UNIX_TIMESTAMP, FORMAT_TIME. Math: SUM, SUB, MUL, DIV, MOD, MIN, MAX. String: CONCAT, LENGTH, CONTAINS, STARTS_WITH, TO_LOWER. Regex: REG_MATCH, REG_VALUE. Other: IF, EXISTS, COALESCE, BUCKET.",
                "minLength": 1,
                "maxLength": 4095
              },
              "name": {
                "type": "string",
                "description": "Name for the new field, used in filters, breakdowns, etc.",
                "minLength": 1,
                "maxLength": 255
              }
            }
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "calculations": {
          "type": "array",
          "description": "Aggregation operations. COUNT: without column counts all events, with column counts non-null values. CONCURRENCY: tracks concurrent events. Percentiles (P001-P999): approximate using t-digest. RATE_*: per-second rates (IMPORTANT: There is no RATE_PER_SEC operator). HEATMAP: distribution buckets. Note: Relational field prefixes NOT supported in calculations.",
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "column": {
                "type": "string",
                "description": "Column name for the operation",
                "minLength": 1
              },
              "op": {
                "$ref": "#/definitions/all_calc_ops"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "op": {
                      "$ref": "#/definitions/calc_op_required_column"
                    }
                  }
                },
                "then": {
                  "required": [
                    "column"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "$ref": "#/definitions/calc_op_no_column"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "column"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        },
        "end_time": {
          "type": "integer",
          "description": "Absolute end time in epoch seconds. Combine with start_time for fixed range, or time_range for duration before this point.",
          "minimum": 1
        },
        "filters": {
          "type": "array",
          "description": "Filter conditions. Supports relational field prefixes for trace queries.",
          "items": {
            "type": "object",
            "required": [
              "column",
              "op"
            ],
            "properties": {
              "column": {
                "type": "string",
                "description": "Field name. Can include relational prefixes (root., parent., child., any., any2., any3., none.) for trace queries.",
                "minLength": 1,
                "pattern": "^((root|parent|child|any|any2|any3|none)\\.|[^.]+)"
              },
              "join_column": {
                "type": "string",
                "description": "Column to join on (only for join-result operator)"
              },
              "op": {
                "$ref": "#/definitions/all_filter_ops"
              },
              "value": {
                "description": "Value for comparison. Type varies by operator - see operator-specific rules."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "exists",
                        "does-not-exist"
                      ]
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "value"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "in",
                        "not-in",
                        "search"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "join-result"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "join_column"
                  ]
                }
              }
            ]
          },
          "maxItems": 100
        },
        "granularity": {
          "type": "integer",
          "description": "Time bucket size in seconds. Choose from predefined human-friendly intervals: 1s, 5s, 10s, 15s, 30s, 1m, 2m, 5m, 10m, 15m, 30m, 1h, 2h, 3h, 4h, 6h, 12h, 1d, 2d, 3d, 7d. Auto-calculated if omitted, targeting ~80 data points for ASCII graphs.",
          "enum": [
            1,
            5,
            10,
            15,
            30,
            60,
            120,
            300,
            600,
            900,
            1800,
            3600,
            7200,
            10800,
            14400,
            21600,
            43200,
            86400,
            172800,
            259200,
            604800
          ]
        },
        "limit": {
          "type": "integer",
          "description": "Max unique groups when using breakdowns (before 'other' bucket). No effect without breakdowns. Default: no limit.",
          "minimum": 1,
          "maximum": 1000
        },
        "orders": {
          "type": "array",
          "description": "Sort order for results. Default: descending. When using relational field prefixes, the same prefix must appear in breakdowns.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "title": "OrderByBreakdown",
                "required": [
                  "column"
                ],
                "properties": {
                  "column": {
                    "type": "string",
                    "description": "Field name from breakdowns (can include relational prefixes)",
                    "minLength": 1,
                    "pattern": "^((root|parent|child|any|any2|any3)\\.|[^.]+)"
                  },
                  "order": {
                    "type": "string",
                    "default": "descending",
                    "enum": [
                      "ascending",
                      "descending"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "title": "OrderByCalculation",
                "required": [
                  "op"
                ],
                "properties": {
                  "column": {
                    "type": "string",
                    "description": "Column from calculation (omit for CONCURRENCY, optional for COUNT)"
                  },
                  "op": {
                    "$ref": "#/definitions/all_calc_ops"
                  },
                  "order": {
                    "type": "string",
                    "default": "descending",
                    "enum": [
                      "ascending",
                      "descending"
                    ]
                  }
                }
              }
            ]
          }
        },
        "start_time": {
          "type": "integer",
          "description": "Absolute start time in epoch seconds. Combine with end_time for fixed range, or time_range for duration from this point.",
          "minimum": 1
        },
        "time_range": {
          "type": "integer",
          "description": "Duration in seconds. Can be used alone (relative to now), with start_time (fixed start), or with end_time (fixed end). Default: 7200.",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "description": "Relative time range from now",
          "required": [
            "time_range"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "start_time"
                ]
              },
              {
                "required": [
                  "end_time"
                ]
              }
            ]
          }
        },
        {
          "description": "Fixed absolute time range",
          "required": [
            "start_time",
            "end_time"
          ],
          "not": {
            "required": [
              "time_range"
            ]
          }
        },
        {
          "description": "Duration from fixed start time",
          "required": [
            "start_time",
            "time_range"
          ],
          "not": {
            "required": [
              "end_time"
            ]
          }
        },
        {
          "description": "Duration before fixed end time",
          "required": [
            "end_time",
            "time_range"
          ],
          "not": {
            "required": [
              "start_time"
            ]
          }
        },
        {
          "description": "Uses default time_range of 7200 seconds",
          "not": {
            "anyOf": [
              {
                "required": [
                  "time_range"
                ]
              },
              {
                "required": [
                  "start_time"
                ]
              },
              {
                "required": [
                  "end_time"
                ]
              }
            ]
          }
        }
      ]
    },
    "results_limit": {
      "type": "integer",
      "description": "Max total results including both aggregates and samples. Samples are capped at this limit when include_samples=true.",
      "default": 1000,
      "minimum": 1,
      "maximum": 10000
    },
    "usage_mode": {
      "type": "boolean",
      "description": "Return raw event counts without sampling rate correction. Applies to all aggregations, not just COUNT.",
      "default": false
    }
  },
  "if": {
    "properties": {
      "environment_wide_query": {
        "const": false
      }
    }
  },
  "then": {
    "required": [
      "dataset_slug"
    ]
  },
  "x-constraints": {
    "defaults": {
      "time_range": 7200
    },
    "null_handling": "Nulls ignored in aggregations except COUNT",
    "operator_naming": "IMPORTANT: Filter operators use symbols (=, >=) while calculated field functions use words (EQUALS, GTE). Never use GTE/LTE as filter operators.",
    "operators": "Use operators exactly as defined - do not invent or modify names",
    "time_units": "All timestamps in epoch seconds (integer)"
  }
}
